# Copy this file to .env. It is ignored by Git.
#
# Address of the ASAO accounts API (the accounts-api folder, deployed on Vercel).
# It is a public address, not a secret; release builds bake it in.
# For local testing, run `npm run dev` in accounts-api and use http://localhost:3000.
ASAO_ACCOUNTS_URL=https://<your-project>.vercel.app
