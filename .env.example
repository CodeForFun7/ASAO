# Copy this file to .env. It is ignored by Git. Everything here is optional.
#
# ASAO uses the deployed accounts API (https://asao-accounts-api-two.vercel.app) by default.
# Set this only to point it somewhere else, for example a local copy of the API
# (`npm run dev` in accounts-api):
# ASAO_ACCOUNTS_URL=http://localhost:3000
