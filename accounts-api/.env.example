# Copy to .env.local for local testing (npm run dev, npm run smoke). On Vercel, set the same
# two variables under Project Settings > Environment Variables instead.
#
# YugabyteDB YSQL connection string from Aeon (Connect > Connect to your Application).
# Write special characters in the password as %XX, for example @ as %40.
DATABASE_URL=postgresql://admin:<password>@<host>:5433/yugabyte?ssl=true&sslmode=verify-full
# The full text of Aeon's root.crt, with line breaks written as \n.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
